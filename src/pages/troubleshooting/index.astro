---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const guides = await getCollection('troubleshooting');
guides.sort((a, b) => {
  const order = { High: 0, Medium: 1, Low: 2 };
  return order[a.data.severity] - order[b.data.severity];
});

const severityColor = { Low: 'var(--green)', Medium: 'var(--amber)', High: 'var(--red)' };
const severityIcon = { Low: '●', Medium: '●●', High: '●●●' };
---

<BaseLayout
  title="Wahl Peanut Troubleshooting — Fix Cutting, Heat & Noise Issues"
  description="Step-by-step fixes for the most common Wahl Peanut problems. Hot blade, not cutting, loud noise, blade slipping — solved with simple solutions."
>
  <Header />
  <main>
    <section class="hub-hero">
      <div class="container">
        <p class="section-label">Troubleshooting</p>
        <h1>Fix Your Wahl Peanut</h1>
        <p class="hub-sub">Fast, practical fixes for the most common Peanut problems — no tools needed for most issues.</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="trouble-list">
          {guides.map(guide => (
            <a href={`/troubleshooting/${guide.id}`} class="trouble-item" id={`ts-${guide.id}`}>
              <div class="ti-severity" style={`color: ${severityColor[guide.data.severity]}`}>
                {severityIcon[guide.data.severity]}
              </div>
              <div class="ti-content">
                <h2 class="ti-title">{guide.data.problem}</h2>
                <p class="ti-fix">{guide.data.quickFix}</p>
              </div>
              <span class="ti-arrow">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
.hub-hero {
  padding: var(--space-16) 0 var(--space-8);
  border-bottom: 1px solid var(--border);
}
.hub-sub {
  color: var(--text-muted);
  font-size: 1.05rem;
  margin-top: var(--space-3);
  max-width: 600px;
}
.trouble-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  max-width: 800px;
}
.trouble-item {
  display: flex;
  align-items: flex-start;
  gap: var(--space-5);
  padding: var(--space-5) var(--space-6);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  text-decoration: none;
  transition: border-color var(--transition), background var(--transition), transform var(--transition);
}
.trouble-item:hover {
  border-color: var(--border-light);
  background: var(--surface-2);
  transform: translateX(4px);
}
.ti-severity {
  font-size: 0.75rem;
  flex-shrink: 0;
  margin-top: 3px;
  letter-spacing: 2px;
}
.ti-content { flex: 1; }
.ti-title {
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--text);
  margin: 0 0 var(--space-2);
  line-height: 1.3;
}
.ti-fix {
  font-size: 0.875rem;
  color: var(--text-muted);
  margin: 0;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.ti-arrow {
  color: var(--text-dim);
  font-size: 1.1rem;
  flex-shrink: 0;
  transition: color var(--transition), transform var(--transition);
}
.trouble-item:hover .ti-arrow {
  color: var(--amber);
  transform: translateX(4px);
}
</style>
