---
interface Spec {
  label: string;
  a: string;
  b: string;
  winner?: 'a' | 'b' | 'tie';
}

interface Props {
  productA: string;
  productB: string;
  specs: Spec[];
}

const { productA, productB, specs } = Astro.props;
---

<div class="comparison-table-wrap">
  <table class="comparison-table" role="table">
    <thead>
      <tr>
        <th class="spec-col" scope="col">Spec</th>
        <th class="product-col product-col--a" scope="col">{productA}</th>
        <th class="product-col product-col--b" scope="col">{productB}</th>
      </tr>
    </thead>
    <tbody>
      {specs.map(spec => (
        <tr>
          <td class="spec-label">{spec.label}</td>
          <td class={`spec-value ${spec.winner === 'a' ? 'spec-value--winner' : ''} ${spec.winner === 'tie' ? 'spec-value--tie' : ''}`}>
            {spec.winner === 'a' && <span class="winner-badge" aria-label="Winner">✓</span>}
            {spec.a}
          </td>
          <td class={`spec-value ${spec.winner === 'b' ? 'spec-value--winner' : ''} ${spec.winner === 'tie' ? 'spec-value--tie' : ''}`}>
            {spec.winner === 'b' && <span class="winner-badge" aria-label="Winner">✓</span>}
            {spec.b}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
.comparison-table-wrap {
  overflow-x: auto;
  border-radius: var(--radius-lg);
  border: 1px solid var(--border);
  margin: var(--space-6) 0;
}

.comparison-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.9rem;
}

.comparison-table thead th {
  background: var(--surface-2);
  padding: var(--space-4) var(--space-5);
  text-align: center;
  font-weight: 700;
  font-size: 0.85rem;
  letter-spacing: 0.04em;
  border-bottom: 1px solid var(--border);
}

.spec-col {
  text-align: left !important;
  color: var(--text-muted);
  width: 30%;
}

.product-col--a { color: var(--chrome-bright); }
.product-col--b { color: var(--amber); }

.comparison-table tbody tr {
  border-bottom: 1px solid var(--border);
  transition: background var(--transition);
}

.comparison-table tbody tr:last-child {
  border-bottom: none;
}

.comparison-table tbody tr:hover {
  background: var(--surface);
}

.spec-label {
  padding: var(--space-3) var(--space-5);
  color: var(--text-muted);
  font-weight: 500;
}

.spec-value {
  padding: var(--space-3) var(--space-5);
  text-align: center;
  color: var(--text-muted);
}

.spec-value--winner {
  color: var(--green);
  font-weight: 600;
  background: rgba(34,197,94,0.05);
}

.spec-value--tie {
  color: var(--text-muted);
}

.winner-badge {
  display: inline-block;
  width: 18px;
  height: 18px;
  background: var(--green);
  color: #000;
  border-radius: 50%;
  font-size: 0.65rem;
  font-weight: 900;
  line-height: 18px;
  text-align: center;
  margin-right: var(--space-2);
}
</style>
