---
interface Props {
  href: string;
  productKey: string;
  productName: string;
  rating?: number;
}

const { href, productKey, productName, rating } = Astro.props;
---

<div class="sticky-banner" id="sticky-affiliate-banner">
  <div class="container sticky-inner">
    <div class="sticky-product">
      <span class="sticky-icon">✂</span>
      <span class="sticky-name">{productName}</span>
      {rating && (
        <span class="sticky-rating">★ {rating.toFixed(1)}</span>
      )}
    </div>
    <div class="sticky-actions">
      <a
        href={href}
        target="_blank"
        rel="noopener noreferrer sponsored"
        class="btn btn--amazon btn--sm sticky-cta"
        id={`sticky-btn-${productKey}`}
        data-product={productKey}
        data-position="sticky"
      >
        Check Price on Amazon →
      </a>
    </div>
  </div>
</div>

<style>
.sticky-banner {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 90;
  background: rgba(14,14,14,0.97);
  border-top: 1px solid var(--border);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  padding: var(--space-3) 0;
  transform: translateY(100%);
  transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.sticky-banner.visible {
  transform: translateY(0);
}

.sticky-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
}

.sticky-product {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  min-width: 0;
}

.sticky-icon {
  font-size: 1.2rem;
  color: var(--chrome);
  flex-shrink: 0;
}

.sticky-name {
  font-weight: 600;
  font-size: 0.9rem;
  color: var(--chrome-bright);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sticky-rating {
  color: var(--amber);
  font-size: 0.85rem;
  font-weight: 600;
  flex-shrink: 0;
}

.sticky-actions {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  flex-shrink: 0;
}

.sticky-cta { animation: none; }

@media (max-width: 600px) {
  .sticky-product { display: none; }
  .sticky-actions { width: 100%; justify-content: center; }
  .sticky-cta { width: 100%; justify-content: center; }
}
</style>

<script>
// Show banner after user scrolls 600px
const banner = document.getElementById('sticky-affiliate-banner');

const toggle = () => {
  if (!banner) return;
  if (window.scrollY > 600) {
    banner.classList.add('visible');
  } else {
    banner.classList.remove('visible');
  }
};

window.addEventListener('scroll', toggle, { passive: true });

// Umami tracking for sticky banner clicks
document.querySelectorAll('[data-position="sticky"]').forEach(btn => {
  btn.addEventListener('click', () => {
    const product = btn.getAttribute('data-product') ?? 'unknown';
    // @ts-ignore
    if (typeof window.umami !== 'undefined') {
      window.umami.track('affiliate-click', { product, position: 'sticky', page: window.location.pathname });
    }
  });
});
</script>
