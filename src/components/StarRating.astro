---
interface Props {
  rating: number;   // 0–5, supports decimals
  maxStars?: number;
  size?: 'sm' | 'md' | 'lg';
  showNumber?: boolean;
  reviewCount?: number;
}

const { rating, maxStars = 5, size = 'md', showNumber = true, reviewCount } = Astro.props;
const clampedRating = Math.min(Math.max(rating, 0), maxStars);
const fullStars = Math.floor(clampedRating);
const hasHalf = clampedRating - fullStars >= 0.5;
const emptyStars = maxStars - fullStars - (hasHalf ? 1 : 0);
---

<div class={`star-rating star-rating--${size}`} aria-label={`Rating: ${clampedRating} out of ${maxStars} stars`} role="img">
  {Array.from({ length: fullStars }).map(() => (
    <svg class="star star--full" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
    </svg>
  ))}
  {hasHalf && (
    <svg class="star star--half" viewBox="0 0 24 24" aria-hidden="true">
      <defs>
        <linearGradient id="half-grad">
          <stop offset="50%" stop-color="currentColor"/>
          <stop offset="50%" stop-color="transparent"/>
        </linearGradient>
      </defs>
      <path fill="url(#half-grad)" stroke="currentColor" stroke-width="0" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
    </svg>
  )}
  {Array.from({ length: emptyStars }).map(() => (
    <svg class="star star--empty" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
    </svg>
  ))}
  {showNumber && (
    <span class="star-number">
      {clampedRating.toFixed(1)}
      {reviewCount && <span class="star-count">({reviewCount.toLocaleString()})</span>}
    </span>
  )}
</div>

<style>
.star-rating {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  color: var(--amber);
}

.star {
  flex-shrink: 0;
}

.star--empty { color: var(--border-light); }

.star-rating--sm .star { width: 14px; height: 14px; }
.star-rating--md .star { width: 18px; height: 18px; }
.star-rating--lg .star { width: 24px; height: 24px; }

.star-number {
  margin-left: var(--space-2);
  font-weight: 700;
  color: var(--amber);
}

.star-rating--sm .star-number { font-size: 0.8rem; }
.star-rating--md .star-number { font-size: 0.9rem; }
.star-rating--lg .star-number { font-size: 1.1rem; }

.star-count {
  font-weight: 400;
  color: var(--text-muted);
  font-size: 0.85em;
  margin-left: 2px;
}
</style>
