---
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyAffiliateBanner from '../components/StickyAffiliateBanner.astro';
import StarRating from '../components/StarRating.astro';
import ProsCons from '../components/ProsCons.astro';
import AffiliateButton from '../components/AffiliateButton.astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  product: string;
  rating: number;
  amazonUrl: string;
  amazonPrice?: string;
  pros: string[];
  cons: string[];
  verdict: string;
  audience: ('barbers' | 'at-home')[];
  pubDate: Date;
  updatedDate?: Date;
  slug: string;
}

const {
  title,
  description,
  product,
  rating,
  amazonUrl,
  amazonPrice,
  pros,
  cons,
  verdict,
  audience,
  pubDate,
  updatedDate,
  slug,
} = Astro.props;

const reviewSchema = {
  "@context": "https://schema.org",
  "@type": "Review",
  "name": title,
  "reviewBody": description,
  "reviewRating": {
    "@type": "Rating",
    "ratingValue": rating,
    "bestRating": 5,
    "worstRating": 1,
  },
  "author": {
    "@type": "Organization",
    "name": "Peanut Clippers",
  },
  "itemReviewed": {
    "@type": "Product",
    "name": product,
  },
  "datePublished": pubDate.toISOString(),
  ...(updatedDate && { "dateModified": updatedDate.toISOString() }),
};
---

<BaseLayout title={title} description={description} schema={reviewSchema}>
  <Header />

  <main>
    <article class="review-article">
      <div class="container container--narrow">
        <BreadcrumbNav crumbs={[
          { label: 'Reviews', href: '/reviews/' },
          { label: product },
        ]} />

        <!-- Hero -->
        <header class="review-header">
          <div class="review-meta">
            {audience.map(a => (
              <span class={`badge badge--${a === 'barbers' ? 'barber' : 'home'}`}>
                {a === 'barbers' ? '✂ Barbers' : '🏠 At-Home'}
              </span>
            ))}
            <time class="review-date" datetime={pubDate.toISOString()}>
              {updatedDate
                ? `Updated ${updatedDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}`
                : pubDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}
            </time>
          </div>

          <h1>{title}</h1>

          <div class="review-hero-row">
            <StarRating rating={rating} size="lg" />
            <span class="review-score-label">Our Score: <strong>{rating}/5</strong></span>
          </div>

          <p class="review-verdict-intro">{verdict}</p>

          <div class="review-cta-top">
            <AffiliateButton
              href={amazonUrl}
              productKey={slug}
              size="lg"
              position="top"
            />
          </div>
        </header>

        <hr class="gradient-line" />

        <!-- Pros / Cons -->
        <ProsCons pros={pros} cons={cons} />

        <!-- MDX content -->
        <div class="prose">
          <slot />
        </div>

        <!-- Bottom CTA -->
        <div class="review-cta-bottom">
          <h3>Ready to Buy?</h3>
          <p class="text-muted">Check the latest price on Amazon — often lower than MSRP.</p>
          <AffiliateButton
            href={amazonUrl}
            productKey={slug}
            size="lg"
            position="bottom"
          />
        </div>
      </div>
    </article>
  </main>

  <StickyAffiliateBanner
    href={amazonUrl}
    productKey={slug}
    productName={product}
    rating={rating}
  />

  <Footer />
</BaseLayout>

<style>
.review-article {
  padding: var(--space-10) 0 var(--space-20);
}

.review-header {
  margin-bottom: var(--space-8);
}

.review-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.review-date {
  font-size: 0.8rem;
  color: var(--text-dim);
}

.review-header h1 {
  margin-bottom: var(--space-4);
}

.review-hero-row {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  margin-bottom: var(--space-4);
}

.review-score-label {
  color: var(--text-muted);
  font-size: 0.9rem;
}

.review-verdict-intro {
  font-size: 1.1rem;
  color: var(--text-muted);
  line-height: 1.7;
  border-left: 3px solid var(--amber);
  padding-left: var(--space-5);
  margin-bottom: var(--space-6);
}

.review-cta-top {
  margin: var(--space-6) 0;
}

.review-cta-bottom {
  margin-top: var(--space-12);
  padding: var(--space-8);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-xl);
  text-align: center;
}

.review-cta-bottom h3 {
  margin-bottom: var(--space-2);
}

.review-cta-bottom p {
  color: var(--text-muted);
  margin-bottom: var(--space-5);
}

.review-cta-bottom .affiliate-wrap {
  align-items: center;
}

/* Padding for sticky banner */
body { padding-bottom: 80px; }
</style>
