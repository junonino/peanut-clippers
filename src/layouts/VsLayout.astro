---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import AffiliateButton from '../components/AffiliateButton.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import BaseLayout from './BaseLayout.astro';

interface Spec {
  label: string;
  a: string;
  b: string;
  winner?: 'a' | 'b' | 'tie';
}

interface Props {
  title: string;
  description: string;
  productA: string;
  productB: string;
  productAUrl: string;
  productBUrl: string;
  productAPrice?: string;
  productBPrice?: string;
  winner: string;
  winnerReason: string;
  audience: ('barbers' | 'at-home')[];
  pubDate: Date;
  updatedDate?: Date;
  slug: string;
  specs?: Spec[];
}

const {
  title,
  description,
  productA,
  productB,
  productAUrl,
  productBUrl,
  productAPrice,
  productBPrice,
  winner,
  winnerReason,
  audience,
  pubDate,
  updatedDate,
  slug,
  specs = [],
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <Header />

  <main>
    <article class="vs-article">
      <div class="container container--narrow">
        <BreadcrumbNav crumbs={[
          { label: 'Compare', href: '/vs/' },
          { label: title },
        ]} />

        <header class="vs-header">
          <div class="review-meta">
            {audience.map(a => (
              <span class={`badge badge--${a === 'barbers' ? 'barber' : 'home'}`}>
                {a === 'barbers' ? '✂ Barbers' : '🏠 At-Home'}
              </span>
            ))}
            <time class="review-date" datetime={pubDate.toISOString()}>
              {updatedDate
                ? `Updated ${updatedDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}`
                : pubDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}
            </time>
          </div>

          <h1>{title}</h1>
          <p class="vs-intro">{description}</p>
        </header>

        <!-- Winner verdict box -->
        <div class="verdict-box">
          <div class="verdict-label">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            Our Pick
          </div>
          <div class="verdict-winner">{winner}</div>
          <p class="verdict-reason">{winnerReason}</p>
        </div>

        <!-- Quick Buy Both -->
        <div class="vs-buy-row">
          <div class="vs-buy-card vs-buy-card--a">
            <div class="vs-buy-label">Option A</div>
            <div class="vs-buy-name">{productA}</div>
            <AffiliateButton
              href={productAUrl}
              productKey={`${slug}-a`}
              label="Buy on Amazon"
              price={productAPrice}
              size="sm"
              position="top-a"
            />
          </div>
          <div class="vs-divider">vs</div>
          <div class="vs-buy-card vs-buy-card--b">
            <div class="vs-buy-label">Option B</div>
            <div class="vs-buy-name">{productB}</div>
            <AffiliateButton
              href={productBUrl}
              productKey={`${slug}-b`}
              label="Buy on Amazon"
              price={productBPrice}
              size="sm"
              position="top-b"
            />
          </div>
        </div>

        <!-- Comparison Table -->
        {specs.length > 0 && (
          <ComparisonTable productA={productA} productB={productB} specs={specs} />
        )}

        <!-- MDX content -->
        <div class="prose">
          <slot />
        </div>

        <!-- Bottom CTAs -->
        <div class="vs-bottom-ctas">
          <div class="vs-bottom-cta">
            <h4>{productA}</h4>
            <AffiliateButton href={productAUrl} productKey={`${slug}-a`} price={productAPrice} position="bottom-a" />
          </div>
          <div class="vs-bottom-cta">
            <h4>{productB}</h4>
            <AffiliateButton href={productBUrl} productKey={`${slug}-b`} price={productBPrice} position="bottom-b" />
          </div>
        </div>
      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
.vs-article {
  padding: var(--space-10) 0 var(--space-20);
}

.vs-header {
  margin-bottom: var(--space-8);
}

.vs-intro {
  font-size: 1.05rem;
  color: var(--text-muted);
  line-height: 1.7;
  margin-top: var(--space-4);
}

.review-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.review-date {
  font-size: 0.8rem;
  color: var(--text-dim);
}

/* Verdict box */
.verdict-box {
  background: linear-gradient(135deg, rgba(245,158,11,0.08), rgba(245,158,11,0.04));
  border: 1px solid rgba(245,158,11,0.3);
  border-radius: var(--radius-xl);
  padding: var(--space-6) var(--space-8);
  margin: var(--space-8) 0;
}

.verdict-label {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--amber);
  margin-bottom: var(--space-3);
}

.verdict-winner {
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--text);
  margin-bottom: var(--space-3);
}

.verdict-reason {
  color: var(--text-muted);
  margin: 0;
  font-size: 0.95rem;
}

/* Buy row */
.vs-buy-row {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: var(--space-4);
  align-items: center;
  margin: var(--space-6) 0;
}

.vs-buy-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.vs-buy-card--a { border-color: rgba(192,192,192,0.2); }
.vs-buy-card--b { border-color: rgba(245,158,11,0.2); }

.vs-buy-label {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--text-dim);
}

.vs-buy-name {
  font-weight: 600;
  font-size: 0.9rem;
  color: var(--text);
  line-height: 1.3;
}

.vs-divider {
  font-family: var(--font-display);
  font-size: 2rem;
  color: var(--text-dim);
  text-align: center;
  letter-spacing: 0.05em;
}

/* Bottom CTAs */
.vs-bottom-ctas {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-4);
  margin-top: var(--space-12);
  padding: var(--space-8);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-xl);
}

.vs-bottom-cta {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.vs-bottom-cta h4 {
  font-size: 0.9rem;
  color: var(--text-muted);
}

@media (max-width: 600px) {
  .vs-buy-row {
    grid-template-columns: 1fr;
  }
  .vs-divider { text-align: center; }
  .vs-bottom-ctas {
    grid-template-columns: 1fr;
  }
}
</style>
